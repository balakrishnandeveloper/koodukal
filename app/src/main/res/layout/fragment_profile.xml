<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/parent_cons"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <FrameLayout
            android:id="@+id/profileContainer"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/imgProfile"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:src="@drawable/ic_camera"
                android:scaleType="centerCrop"
                app:civ_border_width="2dp"
                app:civ_border_color="@color/app_color"/>


            <ImageView
                android:id="@+id/imgEdit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_edit"
                android:background="@drawable/circle_green_fill"
                android:padding="6dp"
                android:layout_gravity="bottom|end" />

        </FrameLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sub_cons"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/profileContainer">


            <ImageView
                android:id="@+id/iv_birds_parent"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/birds_icon"
                android:layout_marginStart="5dp"
                android:layout_marginHorizontal="20dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:tint="@color/app_color" />



            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Name"
                android:textColor="@color/black"
                android:layout_marginHorizontal="20dp"
                android:textColorHint="@color/black"
                android:layout_marginTop="20dp"
                android:drawableEnd="@drawable/ic_email"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/edittext_green_border"
                android:inputType="text"
                android:focusable="false"
                android:layout_marginBottom="16dp"/>



            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Email Address"
                android:textColor="@color/black"
                android:layout_marginHorizontal="20dp"
                android:textColorHint="@color/black"
                android:layout_marginTop="20dp"
                android:focusable="false"
                android:drawableEnd="@drawable/ic_email_address"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etUsername"
                android:background="@drawable/edittext_green_border"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="16dp"/>


            <EditText
                android:id="@+id/etMobile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Mobile Number"
                android:textColor="@color/black"
                android:layout_marginHorizontal="20dp"
                android:textColorHint="@color/black"
                android:layout_marginTop="20dp"
                android:focusable="false"
                android:drawableEnd="@drawable/ic_mobile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etEmail"
                android:background="@drawable/edittext_green_border"
                android:inputType="number"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Location"
                android:textColor="@color/black"
                android:layout_marginHorizontal="20dp"
                android:textColorHint="@color/black"
                android:layout_marginTop="20dp"
                android:focusable="false"
                android:drawableEnd="@drawable/ic_location"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etMobile"
                android:background="@drawable/edittext_green_border"
                android:inputType="number"
                android:layout_marginBottom="16dp"/>



            <androidx.cardview.widget.CardView
                android:id="@+id/terms_lay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/dashboard_card_background"
                app:layout_constraintEnd_toEndOf="@+id/etLocation"
                app:layout_constraintStart_toStartOf="@+id/etLocation"
                app:layout_constraintTop_toBottomOf="@+id/etLocation"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="15dp"
                    android:background="@drawable/edittext_green_border">

                    <TextView
                        android:text="🐦 My Contribution"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/app_color"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/txtNestCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nests Installed: 5"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:id="@+id/txtBirdVisits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:text="Bird Visits: 20"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:text="Save Profile"
                android:textAllCaps="false"
                android:textColor="@color/app_color"
                android:background="@drawable/edittext_green_border"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginHorizontal="25dp"
                app:layout_constraintTop_toBottomOf="@id/terms_lay"
                app:layout_constraintStart_toStartOf="@id/etLocation"
                app:layout_constraintEnd_toEndOf="@id/etLocation"/>



        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>