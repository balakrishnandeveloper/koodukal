<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/btm_iv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/register_layer_two"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <ImageView
            android:id="@+id/iv_layer_one"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/register_layer_one"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>


        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo"
            android:layout_margin="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <TextView
            android:id="@+id/title_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_title"
            android:textColor="@color/app_color"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/iv_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_logo" />



        <TextView
            android:id="@+id/sub_title_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Giant Leaps Begin with a Single Step"
            android:textColor="@color/app_color"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_layer_one" />



        <TextView
            android:id="@+id/notes_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Koodugal (NEST Network for Environment sustainability Trust) as an unified team is trying to recreate, reduce and solve. By recreating a space for sparrow in your homes we are trying to save a species on the verge of extinction and thereby can balance the food chain."
            android:textColor="@color/black"
            android:textSize="15sp"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/sub_title_txt" />



        <TextView
            android:id="@+id/sub_notes_title_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="We are also focus on:"
            android:textColor="@color/app_color"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/notes_txt" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contant_cons_lay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/content_border_app_color"
            app:layout_constraintStart_toStartOf="@+id/iv_logo"
            app:layout_constraintTop_toBottomOf="@+id/sub_notes_title_txt">



            <ImageView
                android:id="@+id/home_iv"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/home_iv"
                android:layout_margin="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/sub_title_one_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Sparrow Conservation"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/home_iv"
                app:layout_constraintStart_toEndOf="@+id/home_iv"
                app:layout_constraintTop_toTopOf="@+id/home_iv" />

            <ImageView
                android:id="@+id/agri_iv"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/agricultrure_iv"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="@+id/home_iv"
                app:layout_constraintTop_toBottomOf="@+id/home_iv" />



            <TextView
                android:id="@+id/sub_title_agri_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="koodugal Agriculture"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toEndOf="@+id/agri_iv"
                app:layout_constraintTop_toTopOf="@+id/agri_iv"
                app:layout_constraintBottom_toBottomOf="@+id/agri_iv" />




            <ImageView
                android:id="@+id/water_iv"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/water_iv"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="@+id/home_iv"
                app:layout_constraintTop_toBottomOf="@+id/agri_iv" />



            <TextView
                android:id="@+id/sub_title_water_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Water Management"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toEndOf="@+id/water_iv"
                app:layout_constraintTop_toTopOf="@+id/water_iv"
                app:layout_constraintBottom_toBottomOf="@+id/water_iv" />



            <ImageView
                android:id="@+id/rural_iv"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/rural_iv"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="@+id/home_iv"
                app:layout_constraintTop_toBottomOf="@+id/water_iv" />



            <TextView
                android:id="@+id/sub_title_rural_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Digitalizing Rural India"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toEndOf="@+id/rural_iv"
                app:layout_constraintTop_toTopOf="@+id/rural_iv"
                app:layout_constraintBottom_toBottomOf="@+id/rural_iv" />


            <ImageView
                android:id="@+id/birds_tree_iv"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/birds_tree_iv"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="@+id/home_iv"
                app:layout_constraintTop_toBottomOf="@+id/rural_iv" />



            <TextView
                android:id="@+id/sub_title_birds_tree_txt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Bird Sanctuary by Planting Native Trees"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/birds_tree_iv"
                app:layout_constraintTop_toTopOf="@+id/birds_tree_iv"
                app:layout_constraintBottom_toBottomOf="@+id/birds_tree_iv" />

        </androidx.constraintlayout.widget.ConstraintLayout>




        <TextView
            android:id="@+id/web_link_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="Click here to visit website for more information"
            android:textColor="@color/link_color"
            android:textSize="15sp"
            android:textStyle="italic"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/contant_cons_lay"
            app:layout_constraintTop_toBottomOf="@+id/contant_cons_lay" />

        <ImageView
            android:id="@+id/back_iv"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/left_arrow_ic"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>


    <ImageView
        android:id="@+id/btm_iv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/bottom_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>